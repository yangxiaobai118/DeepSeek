{
  "server": {
    "publicIp": "203.0.113.10",
    "email": "admin@example.com",
    "secret": "REPLACE_WITH_64_CHAR_RANDOM_SECRET",
    "domains": {
      "web": "www.example.com"
    },
    "cert": {
      "certFile": "/etc/uniproxy/certs/fullchain.pem",
      "keyFile": "/etc/uniproxy/certs/privkey.pem"
    }
  },
  "ports": {
    "http": 80,
    "https": 443,
    "nginxInternalTls": 8443
  },
  "panels": {
    "xui": {
      "enabled": true,
      "domain": "xui.example.com",
      "listen": "127.0.0.1",
      "port": 54321
    },
    "sui": {
      "enabled": true,
      "domain": "sui.example.com",
      "listen": "127.0.0.1",
      "port": 2095,
      "sub": {
        "enabled": true,
        "domain": "sub.example.com",
        "port": 2096,
        "path": "/sub/"
      }
    }
  },
  "nginx": {
    "mode": "stream",
    "http2": "listen",
    "sites": [
      {
        "serverName": "www.example.com",
        "root": "/var/www/html",
        "index": "index.html"
      }
    ],
    "extraSites": []
  },
  "subscription": {
    "enabled": true,
    "basePath": "/sub",
    "publicBase": "",
    "webPageUrl": "",
    "supportUrl": "",
    "updateIntervalHours": 12,
    "profileTitle": "uniproxy",
    "routing": {
      "bypassPrivate": true,
      "directDomains": [],
      "directCidrs": [],
      "blockDomains": []
    }
  },
  "alerts": {
    "enabled": true,
    "webhook": "",
    "command": "",
    "cooldownHours": 12,
    "checkCores": true
  },
  "users": [],
  "xray": {
    "enabled": true,
    "logLevel": "warning",
    "inbounds": [
      {
        "tag": "xray-vless-reality",
        "protocol": "vless",
        "listen": "127.0.0.1",
        "port": 10443,
        "sni": "www.bing.com",
        "network": "tcp",
        "security": "reality",
        "reality": {
          "dest": "www.bing.com:443",
          "serverNames": [
            "www.bing.com"
          ],
          "privateKey": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "shortIds": [
            "0123456789abcdef"
          ]
        },
        "clients": [
          {
            "id": "11111111-2222-4333-8444-555555555555",
            "name": "user1",
            "flow": "xtls-rprx-vision"
          }
        ]
      }
    ]
  },
  "singbox": {
    "enabled": true,
    "logLevel": "warn",
    "inbounds": [
      {
        "tag": "sb-vless-ws-tls",
        "listen": "127.0.0.1",
        "port": 2052,
        "sni": "sb.example.com",
        "network": "ws",
        "security": "tls",
        "path": "/sbws",
        "users": [
          {
            "uuid": "66666666-7777-4888-8999-000000000000",
            "name": "sbuser"
          }
        ]
      }
    ]
  },
  "apply": {
    "xrayConfig": "/usr/local/etc/xray/config.json",
    "singboxConfig": "/usr/local/etc/sing-box/config.json",
    "nginxConfig": "/etc/nginx/nginx.conf",
    "backup": true
  }
}