{
  "server": {
    "publicIp": "203.0.113.10",
    "email": "admin@example.com",
    "domains": {
      "web": "www.example.com"
    },
    "cert": {
      "certFile": "/etc/uniproxy/certs/fullchain.pem",
      "keyFile": "/etc/uniproxy/certs/privkey.pem"
    }
  },
  "ports": {
    "http": 80,
    "https": 443,
    "nginxInternalTls": 8443
  },
  "panels": {
    "xui": {
      "enabled": true,
      "domain": "xui.example.com",
      "listen": "127.0.0.1",
      "port": 54321
    },
    "sui": {
      "enabled": true,
      "domain": "sui.example.com",
      "listen": "127.0.0.1",
      "port": 2095
    }
  },
  "nginx": {
    "mode": "stream",
    "sites": [
      {
        "serverName": "www.example.com",
        "root": "/var/www/html",
        "index": "index.html"
      }
    ]
  },
  "xray": {
    "enabled": true,
    "logLevel": "warning",
    "inbounds": [
      {
        "tag": "xray-vless-reality",
        "protocol": "vless",
        "listen": "127.0.0.1",
        "port": 10443,
        "sni": "www.bing.com",
        "network": "tcp",
        "security": "reality",
        "reality": {
          "dest": "www.bing.com:443",
          "serverNames": [
            "www.bing.com"
          ],
          "privateKey": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "shortIds": [
            "0123456789abcdef"
          ]
        },
        "clients": [
          {
            "id": "6f1a7d2e-0000-4000-8000-000000000001",
            "email": "user1",
            "flow": "xtls-rprx-vision"
          }
        ]
      }
    ]
  },
  "singbox": {
    "enabled": true,
    "logLevel": "warn",
    "inbounds": [
      {
        "tag": "sb-vless-ws-tls",
        "listen": "127.0.0.1",
        "port": 2052,
        "sni": "sb.example.com",
        "network": "ws",
        "security": "tls",
        "wsPath": "/sbws",
        "users": [
          {
            "uuid": "6f1a7d2e-0000-4000-8000-000000000002",
            "name": "sbuser",
            "flow": ""
          }
        ]
      }
    ]
  }
}
