{
  "name": "uniproxy",
  "version": "0.4.2",
  "description": "Unified control plane for Xray, sing-box and nginx on a single host: one config, port planning, native configs, 443 SNI multiplexing, a user registry with quotas/expiry, and per-user subscriptions (base64 / sing-box / Clash).",
  "type": "module",
  "bin": {
    "uniproxy": "./src/index.js",
    "u-ui": "./src/u-ui.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "src",
    "test",
    "README.md",
    "CHANGELOG.md",
    "DISCLAIMER.md",
    "config.example.json"
  ],
  "scripts": {
    "init": "node src/index.js init -c config.json",
    "validate": "node src/index.js validate -c config.json",
    "ports": "node src/index.js ports -c config.json",
    "generate": "node src/index.js generate -c config.json -o out",
    "links": "node src/index.js links -c config.json",
    "serve": "node src/index.js serve -c config.json",
    "ui": "node src/index.js ui -c config.json",
    "test": "node --test test/",
    "subscribe": "node src/index.js subscribe -c config.json",
    "doctor": "node src/index.js doctor -c config.json",
    "apply": "node src/index.js apply -c config.json",
    "users": "node src/index.js users -c config.json",
    "alerts": "node src/index.js alerts -c config.json",
    "pack:platforms": "node scripts/package.mjs --out dist",
    "build:sea": "node scripts/build-sea.mjs --out bin"
  }
}
